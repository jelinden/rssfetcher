# /etc/rssfetcher/env — the only place credentials belong.
#
#   chmod 600 /etc/rssfetcher/env        (it is world-readable if you forget)
#
# systemd reads this through EnvironmentFile=; for a shell, start-prod.sh and
# start-local.sh load the environment they were started with, so:
#
#   set -a; . /etc/rssfetcher/env; set +a; ./start-prod.sh
#
# Never put these in ExecStart or on a command line: argv is world readable
# through ps(1) and /proc/<pid>/cmdline. This file holds no values on purpose -
# copy it, fill it in, and keep it out of git (it is .gitignored as .env).

# MongoDB connection URI, including the database name. Without it the binary uses
# -address (mongodb://localhost:27017) and -database (news).
# MONGO_URI=mongodb://<user>:<password>@192.168.0.1:27017/news
MONGO_URI=

# The admin account created on the first start. Existing accounts are never
# overwritten, so these matter exactly once. Leaving the password empty makes the
# binary generate a strong one and print it once on startup, which keeps this file
# free of the actual secret.
RSSFETCHER_ADMIN_USER=
RSSFETCHER_ADMIN_PASSWORD=

# HMAC key for the CSRF tokens. Rotate whenever a value here may have leaked; that
# logs nobody out, it only invalidates forms that were open at the time.
# Generate: openssl rand -hex 32
RSSFETCHER_AUTH_SECRET=

# Optional tuning. These are read by the start scripts, which pass them on as
# flags; when you run through the systemd unit, the -flags in its ExecStart are the
# policy and belong there instead. Empty means "use the default".
RSSFETCHER_LISTEN=
RSSFETCHER_INTERVAL=
RSSFETCHER_JITTER=
RSSFETCHER_MAX_FEED_TTL=
RSSFETCHER_FETCH_TIMEOUT=
RSSFETCHER_CHECK_TIMEOUT=
RSSFETCHER_MAX_ITEMS=
# "true" when the UI is served over HTTPS (sets the Secure cookie flag and HSTS).
RSSFETCHER_COOKIE_SECURE=
# "true" to poll every feed on every cycle, ignoring the <ttl> a feed publishes.
RSSFETCHER_IGNORE_FEED_TTL=
