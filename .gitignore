# Build artefacts (the binary contains no credentials, but keep it out of the
# index so a locally built one is never committed).
/rssfetcher
/rssfetcher.exe
/rssFetcher

nohup.out
*.log

# Local configuration: MONGO_URI with its credentials, the admin password and
# RSSFETCHER_AUTH_SECRET. Never commit this.
.env
.env.*
!.env.example

# Runtime state of background starts (pidfile).
/run/
